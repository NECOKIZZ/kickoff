# kickoff workspace env — copy to .env.local and fill in. Two processes read
# this file: the markets app (Next.js) and the kickoff-data service
# (worker + API). Blank value = that feature runs in mock/off mode.

# ============================================================
# Markets app
# ============================================================
DATABASE_URL=postgres://user:pass@localhost:5432/kickoff

# Robinhood Chain — testnet now, mainnet at cutover (config swap, not code).
# Contract addresses come from the deploy run (see contracts/); chain features
# stay OFF until ESCROW + DEPLOYER_PRIVATE_KEY are both set (CHAIN_ENABLED).
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_MOCKUSDC_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
# AgentVault (agent accounts) from the v2 deploy. Unset = agents run off-chain (dev).
NEXT_PUBLIC_AGENT_VAULT_ADDRESS=
# Browser RPC override (defaults to the public testnet RPC). Local anvil: http://localhost:8545
#NEXT_PUBLIC_RH_RPC_URL=
# Testnet-only throwaway signer — NEVER a mainnet key.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
# Optional separate key for the AgentVault operator (registers agents, places
# their picks). Defaults to DEPLOYER_PRIVATE_KEY on testnet.
#AGENT_OPERATOR_PRIVATE_KEY=
# "Get test funds" drip from the server wallet (per wallet, once per 24h, only when low).
#FAUCET_ETH_WEI=200000000000000
#FAUCET_TUSDC=100000000

# Managed (soul.md) agents run on Kickoff's OpenRouter key (sk-or-v1-…). Unset = managed mode off.
OPENROUTER_API_KEY=
# Model (OpenRouter slug) + effort for managed runs (one call per agent per batch of fixtures).
#MANAGED_AGENT_MODEL=anthropic/claude-opus-5.5
#MANAGED_AGENT_EFFORT=low
# Scheduler: run agents for markets locking within this window; caps per agent/tick.
#MANAGED_AGENT_LOOKAHEAD_HOURS=12
#MANAGED_AGENT_MAX_RUNS_PER_DAY=4
#MANAGED_AGENT_MAX_PER_TICK=25
# Bearer for GET /api/cron/managed-agents (Vercel Cron sends it automatically). openssl rand -hex 24
CRON_SECRET=

# Privy auth — dashboard.privy.io → app settings.
# App ID is public (NEXT_PUBLIC_ = inlined into the client bundle); the secret
# is server-only. BOTH unset = dev-wallet mode (x-dev-address header auth).
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Markets-app admin dashboard key — bearer for /api/admin/* and the /admin UI.
# openssl rand -hex 24
ADMIN_API_KEY=

# Launch gate — signs the invite cookie (waitlist → invite code → app).
# openssl rand -hex 32. Falls back to ADMIN_API_KEY if unset; set it in prod.
INVITE_COOKIE_SECRET=

# ============================================================
# kickoff-data service — sources
# ============================================================
# Own database, SEPARATE from the app's (the app consumes /v1 over HTTP only)
KICKOFF_DATA_DATABASE_URL=postgres://user:pass@localhost:5432/kickoff_data

# S1 API-Football (100 req/day free tier — hard wall). Empty = mock mode
# (recorded fixtures; whole pipeline runs offline).
API_FOOTBALL_KEY=

# S2 football-data.org (free tier). Empty = mock mode.
FOOTBALL_DATA_ORG_KEY=

# S3/S4/S5 Apify actors (Flashscore live + extractor, FSFD tie-breaker).
# Empty = mock mode with recorded payloads from fixtures/apify/.
APIFY_TOKEN=

# FPL — official Fantasy Premier League API. Standalone authority for player
# points (player perps settle on official FPL points; the custom rubric in
# scoring.ts stays intact but is NOT a settlement path). Free and keyless, so
# the mock convention inverts: unset/0 = mock mode (recorded fpl-*.json
# fixtures), set to 1 to fetch live.
KICKOFF_DATA_FPL_LIVE=

# ============================================================
# kickoff-data service — consumer API (/v1)
# ============================================================
# The app dials KICKOFF_DATA_URL and presents KICKOFF_DATA_API_KEY; the
# service listens on KICKOFF_DATA_API_PORT and validates both keys.
# Auth FAILS CLOSED: unset key = every request 401s.
KICKOFF_DATA_URL=http://localhost:8787
KICKOFF_DATA_API_PORT=8787
# openssl rand -hex 24  (two DIFFERENT values — admin key is a separate credential)
KICKOFF_DATA_API_KEY=
KICKOFF_DATA_ADMIN_KEY=

# ============================================================
# kickoff-data service — webhooks (service → app)
# ============================================================
# settlement.ready | settlement.disputed | fixture.status_changed |
# settlement.player_points_ready | settlement.player_points_flagged.
# Empty URL = webhooks off (the app polls /v1/settlement instead).
KICKOFF_DATA_WEBHOOK_URL=
# openssl rand -hex 32 — HMAC-SHA256 over the body, header x-kickoff-signature
KICKOFF_DATA_WEBHOOK_SECRET=

# ============================================================
# kickoff-data service — settlement lane
# ============================================================
# Flashscore becomes a settlement voter ONLY after the >=3-matchday shadow
# burn-in passes with zero FT mismatches vs S1/S2 (spec §6). Until then its
# votes are recorded (shadow) but quorum = S1+S2 only.
KICKOFF_DATA_S3_TRUSTED=false
# Finality delay before a provisional outcome freezes (default 900 = 15 min).
#KICKOFF_DATA_FINALITY_DELAY_SECONDS=900
# Dead-provider alarm: FT this long without quorum → disputed + webhook, so a
# provider outage summons the admin instead of silently hanging the market.
#KICKOFF_DATA_SETTLEMENT_STALL_SECONDS=3600

# FPL player-points lane: alarm when a gameweek sits finished without
# data_checked for this long (default 48h — FPL usually checks within hours).
# Log-only: nothing is blocked, FPL remains the sole authority.
#KICKOFF_DATA_FPL_STALL_SECONDS=172800

# Worker tick + polling cadences are also env-tunable without a deploy:
#KICKOFF_DATA_TICK_SECONDS=30
#KICKOFF_DATA_CADENCE_S3_IN_PLAY_SECONDS=120   # (any name from cadence.ts)
#KICKOFF_DATA_CADENCE_FPL_LIVE_POLL_SECONDS=180

# ============================================================
# kickoff-data service — logging / platform (all optional)
# ============================================================
# json (Railway/prod) | pretty (local). Level: debug|info|warn|error.
#KICKOFF_DATA_LOG_FORMAT=json
#KICKOFF_DATA_LOG_LEVEL=info
# /health flags a worker as stale after this long without a tick heartbeat.
#KICKOFF_DATA_HEARTBEAT_STALE_SECONDS=120
# PORT and RAILWAY_ENVIRONMENT are injected by Railway — never set manually.
