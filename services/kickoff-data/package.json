{
  "name": "@kickoff/data",
  "version": "0.1.0",
  "private": true,
  "description": "kickoff-data — standalone data-truth service. Aggregates football sources into a canonical schema; serves listing, settlement, and charts lanes.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/worker.ts",
    "api": "tsx src/api/server.ts",
    "start:render": "tsx src/render.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@kickoff/engine": "workspace:*",
    "@kickoff/schema": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
